# Copie este archivo como .env y ponga sus propias claves:
#   Copy-Item .env.example .env
# El archivo .env NO se sube al repositorio.

# Clave del usuario administrador (root) de MySQL
MYSQL_ROOT_PASSWORD=cambie_esta_clave_root

# Clave del usuario de trabajo poli01 (la que se usa en Workbench)
POLI01_PASSWORD=cambie_esta_clave_poli01

# Puerto del PC donde quedará MySQL. Si 3306 está ocupado use 3307.
MYSQL_PORT=3306
